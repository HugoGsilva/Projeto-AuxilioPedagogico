# URL base do ambiente alvo dos testes e2e.
# Homologação (padrão): VPS de produção com contas seed.
E2E_BASE_URL=https://extensao.hugogsilva.dev

# Senha das contas seed (mesma para todos os perfis no ambiente de homologação).
E2E_PASSWORD=Dev@12345

# "1" habilita os testes que GRAVAM dados (criar estudo de caso, salvar respostas).
# Deixe vazio para rodar apenas os testes de leitura/permissão/responsividade.
E2E_WRITE=

# "1" habilita o teste de snapshot, que edita o enunciado de uma pergunta seed
# (mudança global no ambiente). Mantenha desligado fora de uma homologação dedicada.
E2E_SNAPSHOT=
