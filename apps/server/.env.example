# Copie para .env e preencha os valores (nunca commitar o .env)
DATABASE_URL=postgres://usuario:senha@localhost:5432/auxilio_pedagogico
# Gere com: openssl rand -base64 32 (mínimo 32 caracteres)
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3001
NODE_ENV=development
# Bootstrap na VPS: ALLOW_SEED=true + SEED_PASSWORD (≥8)
ALLOW_SEED=false
SEED_PASSWORD=
