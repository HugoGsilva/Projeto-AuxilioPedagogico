{
  "name": "auxilio-pedagogico",
  "private": true,
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "catalog": {
      "dotenv": "^17.4.2",
      "zod": "^4.4.3",
      "typescript": "^6.0.3",
      "@types/bun": "^1.3.14",
      "hono": "^4.12.32",
      "@trpc/server": "^11.18.0",
      "better-auth": "1.6.25",
      "lucide-react": "^1.27.0",
      "next-themes": "^0.4.6",
      "react": "^19.2.8",
      "react-dom": "^19.2.8",
      "sonner": "^2.0.7",
      "@trpc/client": "^11.18.0",
      "@types/react": "^19.2.17",
      "@types/react-dom": "^19.2.3",
      "tailwindcss": "^4.3.3"
    }
  },
  "type": "module",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "check-types": "turbo run check-types",
    "dev:web": "turbo run dev -F web",
    "dev:server": "turbo run dev -F server",
    "db:push": "turbo run db:push -F @auxilio-pedagogico/db",
    "db:studio": "turbo run db:studio -F @auxilio-pedagogico/db",
    "db:generate": "turbo run db:generate -F @auxilio-pedagogico/db",
    "db:migrate": "turbo run db:migrate -F @auxilio-pedagogico/db",
    "db:seed": "turbo run db:seed -F @auxilio-pedagogico/db",
    "db:start": "turbo run db:start -F @auxilio-pedagogico/db",
    "db:watch": "turbo run db:watch -F @auxilio-pedagogico/db",
    "db:stop": "turbo run db:stop -F @auxilio-pedagogico/db",
    "db:down": "turbo run db:down -F @auxilio-pedagogico/db"
  },
  "dependencies": {
    "@auxilio-pedagogico/env": "workspace:*",
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@auxilio-pedagogico/config": "workspace:*",
    "@types/bun": "catalog:",
    "turbo": "^2.10.7",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.3.14"
}
